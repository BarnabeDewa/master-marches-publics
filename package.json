{
  "name": "tp-blockhain-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:analyze": "solhint contracts/**/*.sol",
    "contracts:deploy:amoy": "hardhat run scripts/deploy.ts --network polygonAmoy",
    "docs:presentation": "node scripts/generate-presentation.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "hardhat": "^3.21.2",
    "pptxgenjs": "^4.0.1",
    "solhint": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
